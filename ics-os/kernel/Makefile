CC=gcc
LD=ld
OBJCOPY=objcopy
CP=cp
TOOLPREFIX=
DEBUGFLAGS=-g
# -MMD -MP: emit <obj>.d header-dependency files (included below). The manual
# per-rule header prerequisites are sparse; without auto deps, editing a shared
# header (e.g. process/process.h changing sizeof(PCB386)) leaves most objects
# stale and the kernel links a mixed-layout image, corrupting PCB fields and
# saved contexts on every switch. Host build only: the in-OS gcc driver
# (INOS=1) does not support -MMD.
ifeq ($(INOS),1)
HDRDEP=
else
HDRDEP=-MMD -MP
endif
CFLAGS=-std=gnu89 -fno-stack-protector -fgnu89-inline -m64 -mcmodel=large -w -nostdlib \
	-fno-builtin -ffreestanding -fno-pie -fno-pic \
	-fno-asynchronous-unwind-tables \
	-mno-red-zone -msse -msse2 \
	-fno-strict-aliasing -fcommon -c $(DEBUGFLAGS) -I. $(HDRDEP)
ASM=gcc
ASMFLAGS=$(CFLAGS)
LDFLAGS=-m elf_x86_64 -T lscript64.ld --build-id=none -z max-page-size=0x1000 -z noexecstack -nostdlib
MAPFLAGS=-Map mapfile.txt

# Release identifier (override on the make command line, e.g. RELEASE_ID=1.0).
RELEASE_ID ?= 0.01-dev

# Explicit default goal: the full kernel image. build_info.h is listed below
# but must NOT shadow the default goal, or `make -C kernel/` (used by the
# top-level vmdex target) would only regenerate the header and ship a stale image.
.DEFAULT_GOAL := bzImage

# Generate build_info.h (release id + git short hash + dirty flag + UTC build
# timestamp). The recipe always runs but only rewrites the file when the
# (hash, dirty, release) triple changes, so the timestamp is stable across
# rebuilds of the same tree (no rebuild storms).
build_info.h:
	@hash="$$(git rev-parse --short HEAD 2>/dev/null || echo nogit)"; \
	 if [ -n "$$(git status --porcelain 2>/dev/null)" ]; then dirty=1; else dirty=0; fi; \
	 key="$$hash|$$dirty|$(RELEASE_ID)"; \
	 cur="$$(sed -n 's/^#define ICSOS_BUILD_KEY "//p' build_info.h 2>/dev/null)"; \
	 if [ "$$cur" != "$$key" ]; then \
	   ts="$$(date -u +%Y-%m-%dT%H:%M:%SZ)"; \
	   { \
	     echo "/* Generated by kernel/Makefile - do not edit. */"; \
	     echo "#ifndef ICSOS_BUILD_INFO_H"; \
	     echo "#define ICSOS_BUILD_INFO_H"; \
	     echo "#define ICSOS_RELEASE \"$(RELEASE_ID)\""; \
	     echo "#define ICSOS_GIT_HASH \"$$hash\""; \
	     echo "#define ICSOS_GIT_DIRTY \"$$dirty\""; \
	     echo "#define ICSOS_BUILD_TS \"$$ts\""; \
	     echo "#define ICSOS_BUILD_KEY \"$$key\""; \
	     echo "#endif"; \
	   } > build_info.h; \
	   echo "  build_info.h: release=$(RELEASE_ID) build=$$hash dirty=$$dirty $$ts"; \
	 fi

# Prefer uncompressed ELF64 for Multiboot2 (gzip optional).
bzImage: all
	$(OBJCOPY) --only-keep-debug Kernel64.bin Kernel64.sym
	$(OBJCOPY) --strip-debug Kernel64.bin
	$(CP) Kernel64.bin vmdex
	$(CP) vmdex ..
	$(CP) Kernel64.bin Kernel32.bin

all: obj Kernel64.bin

# Strict warning gate (ratchet) for new/hardened code. The legacy unity build
# (kernel32.c) keeps -w because pre-existing legacy TUs carry incompatible-
# pointer-type issues (hardware/chips/irqhandlers.c, hardware/vga/dexvga.c,
# filesystem/fat12.c) that need a dedicated cleanup; the new/hardened TUs are
# strict-compiled here so pointer-arity bugs - the class behind the GPT BPB**
# hang - fail the build.
#
# Each check is its OWN simple recipe line (no shell metacharacters). GNU make
# stops at the first failing line, preserving fail-on-error. Add one line per
# newly hardened TU.
#
# In-OS kbuild (INOS=1) skips the gate: the in-OS gcc driver cannot run
# -fsyntax-only (it always expects assembly output), and the kbuild is a
# build-capability cert, not a host QA gate - the host build enforces it.
STRICTWARN := -Werror=incompatible-pointer-types

ifeq ($(INOS),1)
warncheck:
else
warncheck:
	$(CC) $(TOOLPREFIX) $(filter-out -w,$(CFLAGS)) $(STRICTWARN) -fsyntax-only partition/gpt.c
	$(CC) $(TOOLPREFIX) $(filter-out -w,$(CFLAGS)) $(STRICTWARN) -fsyntax-only console/klog.c
endif

obj: warncheck scheduler.o fat.o ext4.o iso9660.o ramdisk.o devfs.o iomgr.o blkcache.o posixfd.o devmgr_error.o kernel32.o \
		startup.o asmlib.o irqwrap.o context.o ap_trampoline.o lapic.o smp.o kexec.o irq_lifecycle.o vtd.o virtio_blk.o virtio_net.o \
		net_pbuf.o net_netif.o net_ethernet.o net_arp.o net_ipv4.o net_icmp.o net_udp.o net_tcp.o net_sock.o net_sync.o net_inet_config.o
		
kernel32.o: kernel32.c build.h hardware/usb/uhci.c hardware/usb/xhci.c hardware/usb/xhci_policy.h hardware/usb/usb.h hardware/usb/usb_cdc_acm.h hardware/usb/usb_debug.h hardware/dma.h hardware/irq_lifecycle.h \
		hardware/chips/serial.c hardware/ATA/ide.c hardware/ATA/ata_capacity.h \
		partition/crc32.c partition/crc32.h \
		partition/gpt.c partition/gpt.h \
		partition/partdev.c partition/partdev.h \
		hardware/floppy/floppy.c hardware/floppy/floppy.h \
		memory/dexmem.c memory/dexmem.h memory/memlayout.h \
		stdlib/time.c stdlib/time.h \
		hardware/keyboard/keyboard.c hardware/keyboard/kbd_boot_leds.h console/dex_DDL.c \
		console/foreground.c process/dex_taskmgr.c process/pdispatch.c \
		console/console.c console/selfhost.c console/tty.c console/tty.h \
		console/tty_vt.c console/tty_tc.c console/tty_canon.h console/dex_DDL.h console/console_mux.h \
		console/script_comment.h \
	hardware/chips/ports.c hardware/vga/dexvga.c hardware/vga/fbconsole.c hardware/vga/fbconsole.h hardware/vga/fbconsole_geom.h stdlib/qsort.c \
		hardware/dexapm.c hardware/chips/irqhandlers.c memory/dlmalloc.c \
		memory/bsdmallo.c vfs/vfs_core.c module/module.c module/elf_module.c console/dexio.c \
		stdlib/stdlib.c hardware/keyboard/mouse.c hardware/exceptions.c \
		hardware/hardware.c hardware/chips/speaker.c devmgr/dex32_devmgr.c \
		devmgr/extension.c process/environment.c devmgr/bridges.c \
		process/sync.c console/script.c process/process.c process/process.h process/irq_kstack.h dexapi/dex32API.c \
 		hardware/ATA/ide.c vfs/vfs_aux.c vfs/posixfd.h memory/kheap.c memory/dexmalloc.c \
 		vmm/vmm.c kexec.c kexec.h \
 		console/klog.c console/klog.h console/klog_ring.h build_info.h
	$(CC) $(TOOLPREFIX) $(CFLAGS) -o kernel32.o kernel32.c
	

	$(LD) $(LDFLAGS) $(MAPFLAGS)

clean:
	rm -f *.o
	rm -f Kernel64.bin Kernel32.bin
	rm -f Kernel64.sym Kernel32.sym
	rm -f vmdex
	rm -f *.d

# Header dependencies emitted by -MMD -MP. Included last so a missing .d
# (fresh checkout) is not an error.
-include $(wildcard *.d)

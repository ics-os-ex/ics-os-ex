" Minimal ICS-OS defaults.vim.
"
" Vim sources $VIMRUNTIME/defaults.vim when no .vimrc is found.  Keep this
" small: FEAT_TINY does not have every option, and the goal is only to start
" in a sane Vim mode without requiring a full Vim runtime tree.

set nocompatible
set backspace=indent,eol,start
set history=50
set ruler
set showcmd
set number
